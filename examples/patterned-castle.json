{
  "format_version": "1.0",
  "dry_run": true,
  "commands": [],
  "recipes": [
    {
      "id": "patterned_castle",
      "conflict_mode": "reuse",
      "commands": [
        {
          "id": "castle_folder",
          "action": "content.create_folder",
          "arguments": {"path": "/Game/CodexGenerated/ToyCastlePatterned"}
        },
        {"$repeat": {
          "items": [
            {"key":"red","name":"M_PatternRed","color":[0.8,0.03,0.03,1.0]},
            {"key":"blue","name":"M_PatternBlue","color":[0.03,0.12,0.85,1.0]},
            {"key":"yellow","name":"M_PatternYellow","color":[0.95,0.65,0.03,1.0]},
            {"key":"green","name":"M_PatternGreen","color":[0.03,0.65,0.12,1.0]},
            {"key":"purple","name":"M_PatternPurple","color":[0.5,0.05,0.8,1.0]}
          ],
          "template": {
            "id": "material_${key}",
            "action": "material.create",
            "depends_on": ["castle_folder"],
            "arguments": {"folder":"/Game/CodexGenerated/ToyCastlePatterned","name":"${name}","base_color":"${color}","metallic":0.1,"roughness":0.25,"save":true}
          }
        }},
        {
          "id": "castle_blueprint",
          "action": "blueprint.create",
          "depends_on": ["castle_folder"],
          "arguments": {
            "folder": "/Game/CodexGenerated/ToyCastlePatterned",
            "name": "BP_ToyCastlePatterned",
            "parent_class": "/Script/Engine.Actor"
          }
        },
        {
          "id": "build_castle",
          "action": "blueprint.edit",
          "depends_on": ["castle_blueprint","material_red","material_blue","material_yellow","material_green","material_purple"],
          "arguments": {
            "blueprint": "/Game/CodexGenerated/ToyCastlePatterned/BP_ToyCastlePatterned.BP_ToyCastlePatterned",
            "compile": true,
            "save": true,
            "operations": [
              {"$repeat": {
                "items": [
                  {"name":"Foundation","mesh":"/Engine/BasicShapes/Cube.Cube","material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternBlue.M_PatternBlue","location":[0,0,25],"scale":[4.5,3.5,0.5]},
                  {"name":"Keep","mesh":"/Engine/BasicShapes/Cube.Cube","material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternRed.M_PatternRed","location":[0,0,150],"scale":[2.0,1.8,2.0]},
                  {"name":"GateLintel","mesh":"/Engine/BasicShapes/Cube.Cube","material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternYellow.M_PatternYellow","location":[0,-185,120],"scale":[1.2,0.35,0.35]}
                ],
                "template": [
                  {"operation":"add_component","component_type":"/Script/Engine.StaticMeshComponent","component_name":"${name}","attach_to":"DefaultSceneRoot"},
                  {"operation":"set_component_property","component_name":"${name}","property":"static_mesh","value":"${mesh}"},
                  {"operation":"set_component_material","component_name":"${name}","slot":0,"material":"${material}"},
                  {"operation":"set_component_transform","component_name":"${name}","location":"${location}","rotation":[0,0,0],"scale":"${scale}"}
                ]
              }},
              {"$mirror": {
                "axis": "x",
                "item": {"name":"LeftWall","x":-310,"material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternGreen.M_PatternGreen"},
                "overrides": {"name":"RightWall","material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternPurple.M_PatternPurple"},
                "template": [
                  {"operation":"add_component","component_type":"/Script/Engine.StaticMeshComponent","component_name":"${name}","attach_to":"DefaultSceneRoot"},
                  {"operation":"set_component_property","component_name":"${name}","property":"static_mesh","value":"/Engine/BasicShapes/Cube.Cube"},
                  {"operation":"set_component_material","component_name":"${name}","slot":0,"material":"${material}"},
                  {"operation":"set_component_transform","component_name":"${name}","location":["${x}",0,115],"rotation":[0,0,0],"scale":[0.45,2.5,1.3]}
                ]
              }},
              {"$mirror": {
                "axis": "y",
                "item": {"name":"FrontWall","y":-260},
                "overrides": {"name":"BackWall"},
                "template": [
                  {"operation":"add_component","component_type":"/Script/Engine.StaticMeshComponent","component_name":"${name}","attach_to":"DefaultSceneRoot"},
                  {"operation":"set_component_property","component_name":"${name}","property":"static_mesh","value":"/Engine/BasicShapes/Cube.Cube"},
                  {"operation":"set_component_material","component_name":"${name}","slot":0,"material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternYellow.M_PatternYellow"},
                  {"operation":"set_component_transform","component_name":"${name}","location":[0,"${y}",115],"rotation":[0,0,0],"scale":[2.7,0.35,1.3]}
                ]
              }},
              {"$repeat": {
                "items": [
                  {"name":"TowerNW","x":-340,"y":260,"base_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternRed.M_PatternRed","roof_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternBlue.M_PatternBlue"},
                  {"name":"TowerNE","x":340,"y":260,"base_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternBlue.M_PatternBlue","roof_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternYellow.M_PatternYellow"},
                  {"name":"TowerSW","x":-340,"y":-260,"base_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternGreen.M_PatternGreen","roof_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternPurple.M_PatternPurple"},
                  {"name":"TowerSE","x":340,"y":-260,"base_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternPurple.M_PatternPurple","roof_material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternRed.M_PatternRed"}
                ],
                "template": [
                  {"operation":"add_component","component_type":"/Script/Engine.StaticMeshComponent","component_name":"${name}Base","attach_to":"DefaultSceneRoot"},
                  {"operation":"set_component_property","component_name":"${name}Base","property":"static_mesh","value":"/Engine/BasicShapes/Cube.Cube"},
                  {"operation":"set_component_material","component_name":"${name}Base","slot":0,"material":"${base_material}"},
                  {"operation":"set_component_transform","component_name":"${name}Base","location":["${x}","${y}",140],"rotation":[0,0,0],"scale":[1.15,1.15,2.3]},
                  {"operation":"add_component","component_type":"/Script/Engine.StaticMeshComponent","component_name":"${name}Roof","attach_to":"DefaultSceneRoot"},
                  {"operation":"set_component_property","component_name":"${name}Roof","property":"static_mesh","value":"/Engine/BasicShapes/Cone.Cone"},
                  {"operation":"set_component_material","component_name":"${name}Roof","slot":0,"material":"${roof_material}"},
                  {"operation":"set_component_transform","component_name":"${name}Roof","location":["${x}","${y}",315],"rotation":[0,0,0],"scale":[1.35,1.35,1.5]}
                ]
              }},
              {"$grid": {
                "axes": {"x":[-130,0,130],"y":[-150,150]},
                "base": {"z":285},
                "template": [
                  {"operation":"add_component","component_type":"/Script/Engine.StaticMeshComponent","component_name":"Battlement_${x_index}_${y_index}","attach_to":"DefaultSceneRoot"},
                  {"operation":"set_component_property","component_name":"Battlement_${x_index}_${y_index}","property":"static_mesh","value":"/Engine/BasicShapes/Cube.Cube"},
                  {"operation":"set_component_material","component_name":"Battlement_${x_index}_${y_index}","slot":0,"material":"/Game/CodexGenerated/ToyCastlePatterned/M_PatternYellow.M_PatternYellow"},
                  {"operation":"set_component_transform","component_name":"Battlement_${x_index}_${y_index}","location":["${x}","${y}","${z}"],"rotation":[0,0,0],"scale":[0.45,0.45,0.5]}
                ]
              }}
            ]
          }
        },
        {
          "id": "spawn_castle",
          "action": "level.spawn_actor",
          "depends_on": ["build_castle"],
          "arguments": {
            "level": "current",
            "class": "/Game/CodexGenerated/ToyCastlePatterned/BP_ToyCastlePatterned.BP_ToyCastlePatterned_C",
            "actor_label": "Toy Castle Patterned",
            "transform": {"location":[-900,0,0],"rotation":[0,0,0],"scale":[1,1,1]}
          }
        },
        {
          "id": "save_castle_assets",
          "action": "project.save",
          "depends_on": ["spawn_castle"],
          "arguments": {"save_assets":true,"save_level":false}
        }
      ]
    }
  ]
}
